{
  "manifest_version": 3,
  "name": "Twitch Ad Shield",
  "version": "1.0.0",
  "description": "Blocks Twitch stream ads by swapping in an ad-free copy of the stream, or cutting the ad segments out.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Twitch Ad Shield",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["src/worker-hook.js", "src/page.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ad_domains", "enabled": true, "path": "rules/ad-domains.json" }
    ]
  }
}
