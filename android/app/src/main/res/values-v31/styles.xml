<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later read the platform's attribute names, not the
         splash library's; without this copy the icon is silently ignored. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/oztrax_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
