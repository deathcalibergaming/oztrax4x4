<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="backgroundColor">#14181B</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>

    <!-- Behind the WebView until the page paints: the page's own near-black,
         so the handover from splash to map shows no white frame. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>

    <!-- The launch splash: the OzTrax mark on the same near-black, drawn from
         the vector the Play build uses (oztrax_splash_icon). values-v31 holds
         the same with the platform's own attribute names, which is what
         Android 12 and later actually read. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/oztrax_splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
