+/* ---------------------------------------------------------------------
+   Fuel prices
+   PetrolSpy relays the state reporting schemes - in South Australia the
+   mandatory Fuel Pricing Information Scheme - and serves them with CORS
+   open, so the app can ask directly with no server of its own. It is
+   undocumented, so an outage is normal rather than a fault: the row
+   simply does not appear and nothing else changes.
+
+   Kept as the raw station list rather than stitched onto the POIs, so a
+   POI reload does not lose them and the match is redone each render.
+   --------------------------------------------------------------------- */
+let fuelStations = loadLS(LS.fuel, { at: 0, list: [] });
+let fuelBusy = false;
+
+/* What a driver reads off a servo sign, in that order. PetrolSpy calls
+   regular unleaded U91; everyone else calls it ULP. */
+const FUEL_GRADES = [["U91", "ULP"], ["U95", "U95"], ["U98", "U98"],
+                     ["DIESEL", "DIESEL"]];
+
+async function fetchFuel(a) {
+  if (fuelBusy) return;
+  if (fuelStations.list.length && Date.now() - fuelStations.at < CFG.FUEL_TTL) return;
+  fuelBusy = true;
+  /* A degree of latitude is a shade over 111 km anywhere; a degree of
+     longitude shrinks with the cosine, and at 32 south that is a fifth
+     narrower. Using the same figure for both would ask for a box too
+     narrow east to west and miss the servo on the far side of town. */
+  const dLat = (CFG.POI_RADIUS * 1.3) / 111320;
+  const dLng = dLat / Math.max(0.2, Math.cos(a.lat * Math.PI / 180));
+  const url = CFG.PETROLSPY +
+    "?neLat=" + (a.lat + dLat).toFixed(5) + "&neLng=" + (a.lng + dLng).toFixed(5) +
+    "&swLat=" + (a.lat - dLat).toFixed(5) + "&swLng=" + (a.lng - dLng).toFixed(5) +
+    "&ts=" + Date.now();
+  const ctl = new AbortController();
+  const bail = setTimeout(function () { ctl.abort(); }, CFG.FUEL_TIMEOUT);
+  try {
+    const r = await fetch(url, { signal: ctl.signal });
+    if (!r.ok) throw new Error("http " + r.status);
+    const j = await r.json();
+    const rows = ((j.message || {}).list) || [];
+    const list = [];
+    rows.forEach(function (s) {
+      const loc = s.location || {};
+      /* x is longitude and y is latitude, which is the opposite way round
+         to how the rest of this file reads. */
+      if (!isFinite(loc.y) || !isFinite(loc.x)) return;
+      const prices = {};
+      let newest = 0;
+      Object.keys(s.prices || {}).forEach(function (k) {
+        const p = s.prices[k];
+        if (!p || !isFinite(p.amount)) return;
+        prices[k] = p.amount;
+        if (p.updated > newest) newest = p.updated;
+      });
+      if (!Object.keys(prices).length) return;
+      list.push({ name: s.name || s.brand || "Fuel", brand: s.brand || "",
+                  lat: loc.y, lng: loc.x, prices: prices, updated: newest });
+    });
+    /* An empty answer is a real answer out here - plenty of country has no
+       reporting station - so it is stored, and the TTL stops us asking
+       again every time the list refreshes. */
+    fuelStations = { at: Date.now(), list: list };
+    saveLS(LS.fuel, fuelStations);
+    renderPois();
+  } catch (e) {
+    /* No signal, or the endpoint has moved. The last prices stay on screen
+       with their age showing, which out here beats no prices at all. */
+  } finally {
+    clearTimeout(bail);
+    fuelBusy = false;
+  }
+}
+
+/* Matched on position rather than name: OSM calls it "BP Hawker", the
+   scheme may call it "BP Hawker Roadhouse", and the coordinates agree
+   whatever either of them writes on the sign. */
+function fuelFor(p) {
+  if (!p || p.kind !== "fuel" || !fuelStations.list.length) return null;
+  let best = null, bestD = CFG.FUEL_MATCH_M;
+  fuelStations.list.forEach(function (s) {
+    const d = haversine(p, s);
+    if (d < bestD) { bestD = d; best = s; }
+  });
+  return best;
+}
+
+/* A price nobody has confirmed today is worth showing and worth doubting,
+   so the age is always stated and goes amber once it is over a day. */
+function fuelAge(ms) {
+  const h = Math.floor((Date.now() - ms) / 3600000);
+  if (h < 1) return "just now";
+  if (h < 24) return h + "h ago";
+  const d = Math.floor(h / 24);
+  return d + (d === 1 ? " day ago" : " days ago");
+}
+
+function fuelRowHtml(p) {
+  const s = fuelFor(p);
+  if (!s) return "";
+  const have = FUEL_GRADES.filter(function (g) { return isFinite(s.prices[g[0]]); });
+  if (!have.length) return "";
+  const low = Math.min.apply(null, have.map(function (g) { return s.prices[g[0]]; }));
+  const cells = have.map(function (g) {
+    const v = s.prices[g[0]];
+    return '<span class="fp' + (v === low && have.length > 1 ? " best" : "") + '">' +
+      "<i>" + g[1] + "</i><b>" + v.toFixed(1) + "</b></span>";
+  }).join("");
+  const old = Date.now() - s.updated > 86400000;
+  return '<div class="fuelrow">' + cells +
+    '<span class="fage' + (old ? " stale" : "") + '">' + esc(fuelAge(s.updated)) +
+    "</span></div>";
+}
