+      if (t.sunrise.getTime() > when) out.push({ kind: "sunrise", at: t.sunrise });
+      if (t.sunset.getTime() > when) out.push({ kind: "sunset", at: t.sunset });
+    }
+    out.sort(function (a, b) { return a.at - b.at; });
+    return out[0] || null;
+  }
