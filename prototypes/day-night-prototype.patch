+/* NOAA's solar equations - the ones the almanac calculators are built on.
+
+   There is a web API for this, sunrise-sunset.org, and it does work: https,
+   CORS open, about 800ms. It is still the wrong tool twice over. It needs
+   signal, and dusk on the Oodnadatta Track is exactly where there is none;
+   and checked against the US Naval Observatory for Adelaide, Mt Dare, Mount
+   Gambier and Hobart across midsummer, midwinter and the equinox, it is out
+   by up to 132 seconds where this is out by at most 49.
+
+   The phone knows where it is and what the time is. The rest is arithmetic,
+   and arithmetic works in the desert. */
+const Sun = {
+  D: Math.PI / 180,
+  DEG: 180 / Math.PI,
+  DAY: 86400000,
+
+  /* The sun's centre sits 50 arcminutes below the horizon at the moment its
+     upper limb appears to touch it: 34' of atmospheric refraction and 16' of
+     the sun's own radius. That is the definition sunrise and sunset are
+     written to, and the one the almanacs publish against. */
+  HORIZON: -0.833,
+
+  /* Where the sun is at one instant - how far it is declined from the
+     equator, and how far ahead or behind the clock it is running.
+
+     Taken at the instant itself rather than at midnight. The declination
+     moves about 0.4 degrees a day around the equinoxes, which is a degree of
+     altitude by the time it reaches the horizon at these latitudes, and a
+     degree at the horizon is four minutes of daylight. It also keeps this
+     honest against times(): a sunrise it works out is a moment when this
+     function reports the sun at exactly the horizon, and the two can never
+     drift apart on a day boundary. */
+  solar: function (when) {
+    const D = this.D;
+    const T = (when / this.DAY + 2440587.5 - 2451545) / 36525;   /* Julian centuries */
+    const L0 = (280.46646 + T * (36000.76983 + T * 0.0003032)) % 360;
+    const M = 357.52911 + T * (35999.05029 - 0.0001537 * T);
+    const e = 0.016708634 - T * (0.000042037 + 0.0000001267 * T);
+    const C = Math.sin(M * D) * (1.914602 - T * (0.004817 + 0.000014 * T)) +
+              Math.sin(2 * M * D) * (0.019993 - 0.000101 * T) +
+              Math.sin(3 * M * D) * 0.000289;
+    const om = (125.04 - 1934.136 * T) * D;
+    const lambda = L0 + C - 0.00569 - 0.00478 * Math.sin(om);
+    const eps = 23 + (26 + (21.448 - T * (46.815 + T * (0.00059 - T * 0.001813))) / 60) / 60 +
+                0.00256 * Math.cos(om);
+    const y = Math.pow(Math.tan(eps * D / 2), 2);
+    return {
+      dec: Math.asin(Math.sin(eps * D) * Math.sin(lambda * D)) * this.DEG,
+      eqTime: 4 * this.DEG * (y * Math.sin(2 * L0 * D) - 2 * e * Math.sin(M * D) +
+        4 * e * y * Math.sin(M * D) * Math.cos(2 * L0 * D) -
+        0.5 * y * y * Math.sin(4 * L0 * D) - 1.25 * e * e * Math.sin(2 * M * D))
+    };
+  },
+
+  /* The instant the sun is due north, for the solar day this instant falls
+     in. The day is chosen by longitude rather than by the UTC date, which is
+     the whole trick: in South Australia sunrise happens on yesterday's UTC
+     date for most of the year, so a sunrise and a sunset picked off one UTC
+     date are not the same day's. Picked off this, they always are.
+
+     Two passes. The first places noon to within the equation of time - up to
+     a quarter of an hour - and the second reads the equation of time there
+     and is done, because it moves by seconds across a day. */
+  noon: function (lng, when) {
+    const guess = 720 - 4 * lng;                      /* minutes past UTC midnight */
+    const day = Math.round((when - guess * 60000) / this.DAY);
+    let at = day * this.DAY + guess * 60000;
+    at = day * this.DAY + (guess - this.solar(at).eqTime) * 60000;
+    return day * this.DAY + (guess - this.solar(at).eqTime) * 60000;
+  },
+
+  /* Sunrise and sunset either side of that noon. Both are null inside the
+     polar circles, where the sun can pass a whole day without reaching the
+     horizon; `up` says which way it stayed. Nowhere in Australia, but the
+     arithmetic should not lie about it. */
+  times: function (lat, lng, when) {
+    const D = this.D;
+    const at = this.noon(lng, when);
+    const dec = this.solar(at).dec;
+    const cosH = Math.cos((90 - this.HORIZON) * D) /
+                 (Math.cos(lat * D) * Math.cos(dec * D)) -
+                 Math.tan(lat * D) * Math.tan(dec * D);
+    if (cosH > 1 || cosH < -1) {
+      return { sunrise: null, sunset: null, noon: new Date(at), up: cosH < -1 };
+    }
+    const half = Math.acos(cosH) * this.DEG * 4 * 60000;   /* 4 minutes a degree */
+    return { sunrise: new Date(at - half), sunset: new Date(at + half),
+             noon: new Date(at), up: null };
+  },
+
+  /* How high the sun stands right now, in degrees above the horizon.
+
+     The day/night decision is taken from this rather than by comparing the
+     clock against a sunrise, which sidesteps the question of which day a
+     time belongs to entirely. */
+  altitude: function (lat, lng, when) {
+    const D = this.D, s = this.solar(when);
+    const mins = (when % this.DAY) / 60000;           /* past UTC midnight */
+    const ha = (mins + s.eqTime + 4 * lng) / 4 - 180; /* 15 degrees an hour */
+    return Math.asin(Math.sin(lat * D) * Math.sin(s.dec * D) +
